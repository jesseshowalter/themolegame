# Copy to .env and fill in from your Supabase project settings
# (Supabase dashboard → Project Settings → API)

# Your project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# The public "anon" key (safe to expose in a client app protected by RLS)
VITE_SUPABASE_ANON_KEY=

# Passcode that gates the /host dashboard. Pick anything; keep it off the QR code.
VITE_HOST_PASSCODE=mole-master
